rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all unspecified access
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 150
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUserBookmark(data) {
      return data.keys().hasAll(['mythId', 'savedAt'])
        && data.keys().hasOnly(['mythId', 'savedAt', 'category'])
        && data.mythId is string && data.mythId.size() <= 64
        && data.savedAt is string && data.savedAt.size() <= 64
        && (!('category' in data) || (data.category is string && data.category.size() <= 32));
    }

    function isValidUserReadingProgress(data) {
      return data.keys().hasAll(['mythId', 'chapterIndex', 'progressPercent', 'updatedAt'])
        && data.keys().hasOnly(['mythId', 'chapterIndex', 'chapterTitle', 'progressPercent', 'updatedAt'])
        && data.mythId is string && data.mythId.size() <= 64
        && data.chapterIndex is int && data.chapterIndex >= 0
        && data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && (!('chapterTitle' in data) || (data.chapterTitle is string && data.chapterTitle.size() <= 100));
    }

    function isValidUserCreativeNote(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'content', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 64
        && data.title is string && data.title.size() <= 100
        && data.content is string && data.content.size() <= 2000
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // --- Collections ---

    // 1. User Profiles: Isolated strictly to the profile owner
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying users collection broadly
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // 2. Bookmarks subcollection
      match /bookmarks/{bookmarkId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bookmarkId) && isValidUserBookmark(incoming());
        allow update: if isOwner(userId) && isValidId(bookmarkId) && isValidUserBookmark(incoming())
          && incoming().mythId == existing().mythId;
        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }

      // 3. Reading progress subcollection
      match /progress/{progressId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(progressId) && isValidUserReadingProgress(incoming());
        allow update: if isOwner(userId) && isValidId(progressId) && isValidUserReadingProgress(incoming())
          && incoming().mythId == existing().mythId;
        allow delete: if isOwner(userId) && isValidId(progressId);
      }

      // 4. Creative notes subcollection
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && isValidUserCreativeNote(incoming());
        allow update: if isOwner(userId) && isValidId(noteId) && isValidUserCreativeNote(incoming())
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
